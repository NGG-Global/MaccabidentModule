  "AUDIO-S04-06": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 3.6,
        "text": "ראינו שחוויית המטופל מורכבת מהרבה רגעים קטנים."
      },
      {
        "start": 3.84,
        "end": 6.6,
        "text": "לאורך הדרך הוא פוגש אנשי צוות שונים,"
