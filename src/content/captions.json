{
  "AUDIO-S00-01": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 1.58,
        "text": "ברוכים הבאים למכבידנט."
      },
      {
        "start": 1.74,
        "end": 4.86,
        "text": "בכל יום מגיעים למרפאות שלנו מטופלים שונים."
      },
      {
        "start": 5.06,
        "end": 7.04,
        "text": "חלקם מגיעים לבדיקה שגרתית."
      },
      {
        "start": 7.32,
        "end": 9.32,
        "text": "אחרים מגיעים לטיפול מורכב,"
      },
      {
        "start": 9.44,
        "end": 11.54,
        "text": "ואולי גם עם לא מעט חששות."
      },
      {
        "start": 11.86,
        "end": 14.16,
        "text": "אבל יש משהו שמשותף לכולם."
      },
      {
        "start": 14.58,
        "end": 17.76,
        "text": "כל מטופל רוצה לדעת שהוא נמצא בידיים טובות."
      },
      {
        "start": 18.08,
        "end": 21.84,
        "text": "והתחושה הזאת לא מתחילה רק כשהוא מתיישב בכיסא הטיפולים,"
      },
      {
        "start": 22.04,
        "end": 23.68,
        "text": "היא מתחילה הרבה קודם."
      },
      {
        "start": 23.9,
        "end": 26.16,
        "text": "במבט הראשון כשהוא נכנס למרפאה."
      },
      {
        "start": 26.32,
        "end": 28.2,
        "text": "באופן שבו מקבלים את פניו."
      },
      {
        "start": 28.2,
        "end": 31.46,
        "text": "בהסבר שהוא מקבל כשהוא לא בטוח מה עומד לקרות."
      },
      {
        "start": 31.64,
        "end": 35.56,
        "text": "ובדרך שבה אנחנו מלווים אותו גם אחרי שהטיפול יסתיים."
      },
      {
        "start": 35.8,
        "end": 39.2,
        "text": "בדקות הקרובות נכיר את תפיסת השירות של מכבידנט,"
      },
      {
        "start": 39.24,
        "end": 43.56,
        "text": "ונראה איך הפעולות הקטנות שלנו יכולות להשפיע על חוויית המטופל."
      },
      {
        "start": 43.78,
        "end": 46.16,
        "text": "והפעם, אתם לא רק צופים מהצד,"
      },
      {
        "start": 46.46,
        "end": 48.4,
        "text": "אתם אלה שתקבלו את ההחלטות."
      },
      {
        "start": 48.68,
        "end": 49.26,
        "text": "מוכנים?"
      },
      {
        "start": 49.54,
        "end": 50.38,
        "text": "בואו נתחיל."
      }
    ]
  },
  "AUDIO-S01-01": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 3.66,
        "text": "לפני שנתחיל, נשמח להכיר את התפקיד שלכם במרפאה."
      },
      {
        "start": 3.84,
        "end": 7.66,
        "text": "לכל אחד מאנשי הצוות יש חלק חשוב בחוויית המטופל,"
      },
      {
        "start": 7.88,
        "end": 10.94,
        "text": "אבל בכל תפקיד אנחנו פוגשים מצבים קצת שונים."
      },
      {
        "start": 11.38,
        "end": 12.98,
        "text": "בחרו את התפקיד שלכם,"
      },
      {
        "start": 13.02,
        "end": 17.68,
        "text": "כדי שבהמשך תוכלו להתנסות בסיטואציות שקרובות לעבודה היומיומית שלכם."
      },
      {
        "start": 17.96,
        "end": 18.78,
        "text": "אל דאגה,"
      },
      {
        "start": 19.04,
        "end": 22.18,
        "text": "את תפיסת השירות ואת מסע המטופל נכיר יחד,"
      },
      {
        "start": 22.32,
        "end": 23.98,
        "text": "בלי קשר לתפקיד שתבחרו."
      }
    ]
  },
  "AUDIO-S02-01": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 0.96,
        "text": "הכירו את יוסי."
      },
      {
        "start": 1.2,
        "end": 4.18,
        "text": "יוסי הגיע למרפאה לטיפול שנקבע מראש."
      },
      {
        "start": 4.72,
        "end": 8.06,
        "text": "הוא לא מכיר את הצוות ולא לגמרי בטוח מה מצפה לו."
      },
      {
        "start": 8.38,
        "end": 11.88,
        "text": "בואו נראה שתי דרכים שבהן הביקור שלו יכול להתחיל."
      },
      {
        "start": 12.08,
        "end": 14.34,
        "text": "שימו לב לא רק למה שאומרים לו,"
      },
      {
        "start": 14.5,
        "end": 16.48,
        "text": "אלא גם למה שהוא עשוי להרגיש."
      }
    ]
  },
  "AUDIO-S02-02": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 1.52,
        "text": "ראיתם את שתי הגרסאות?"
      },
      {
        "start": 1.9,
        "end": 3.48,
        "text": "עכשיו, חשבו לרגע."
      },
      {
        "start": 3.74,
        "end": 6.36,
        "text": "מה היה ההבדל המשמעותי ביותר ביניהן?"
      },
      {
        "start": 6.58,
        "end": 8.74,
        "text": "בחרו את התשובה המתאימה ביותר."
      }
    ]
  },
  "AUDIO-S02-03": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 2.94,
        "text": "בשתי הגרסאות יוסי הגיע לאותה מרפאה,"
      },
      {
        "start": 3.08,
        "end": 4.88,
        "text": "לאותו תור ולאותו טיפול,"
      },
      {
        "start": 5.12,
        "end": 7.56,
        "text": "אבל חוויית השירות שלו הייתה שונה."
      },
      {
        "start": 7.84,
        "end": 9.86,
        "text": "כשאנחנו יוצרים קשר אישי,"
      },
      {
        "start": 9.86,
        "end": 12.24,
        "text": "מקשיבים ומסבירים מה עומד לקרות,"
      },
      {
        "start": 12.86,
        "end": 15.2,
        "text": "אנחנו עוזרים למטופל להרגיש שרואים אותו,"
      },
      {
        "start": 15.42,
        "end": 20.0,
        "text": "וזה בדיוק המקום שבו תפיסת השירות שלנו מתחילה לקבל משמעות."
      }
    ]
  },
  "AUDIO-S03-01": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 3.28,
        "text": "תפיסת השירות של מכבידנט נקראת בידיים טובות."
      },
      {
        "start": 3.96,
        "end": 7.96,
        "text": "היא מבוססת על שלושה ערכים שמלווים אותנו לאורך המפגש עם המטופל."
      },
      {
        "start": 8.2,
        "end": 9.22,
        "text": "רואים אותך,"
      },
      {
        "start": 9.48,
        "end": 10.76,
        "text": "מתאמצים למענך,"
      },
      {
        "start": 10.88,
        "end": 12.8,
        "text": "ומלווים אותך לאורך הדרך."
      },
      {
        "start": 13.3,
        "end": 16.46,
        "text": "בואו נראה איך כל אחד מהם מתבטא בעבודה שלנו."
      }
    ]
  },
  "AUDIO-S03-02": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 0.72,
        "text": "רואים אותך."
      },
      {
        "start": 1.08,
        "end": 4.98,
        "text": "המשמעות היא שאנחנו לא מחכים תמיד שהמטופל יבקש עזרה."
      },
      {
        "start": 5.7,
        "end": 7.62,
        "text": "אנחנו שמים לב למה שקורה סביבנו,"
      },
      {
        "start": 7.74,
        "end": 9.9,
        "text": "מזהים צרכים ופועלים ביוזמה."
      },
      {
        "start": 10.22,
        "end": 13.56,
        "text": "למשל, כשמטופל נראה מבולבל באזור ההמתנה,"
      },
      {
        "start": 14.12,
        "end": 16.56,
        "text": "אפשר לפנות אליו ולבדוק אם הוא זקוק להכוונה."
      },
      {
        "start": 16.86,
        "end": 18.24,
        "text": "או כשיש עיכוב,"
      },
      {
        "start": 18.34,
        "end": 20.36,
        "text": "אפשר לעדכן אותו באופן יזום,"
      },
      {
        "start": 20.42,
        "end": 22.68,
        "text": "עוד לפני שהוא נאלץ לגשת ולשאול."
      },
      {
        "start": 23.12,
        "end": 23.92,
        "text": "לפעמים,"
      },
      {
        "start": 24.06,
        "end": 27.68,
        "text": "עצם הידיעה שמישהו שם לב אליך עושה הבדל גדול."
      }
    ]
  },
  "AUDIO-S03-03": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 1.26,
        "text": "מתאמצים למענך."
      },
      {
        "start": 1.5,
        "end": 4.0,
        "text": "לא כל המטופלים זקוקים לאותו הדבר."
      },
      {
        "start": 4.26,
        "end": 7.16,
        "text": "יש מטופל שרוצה הסבר קצר וברור."
      },
      {
        "start": 7.4,
        "end": 11.96,
        "text": "יש מטופלת שחוששת מהטיפול וזקוקה למעט יותר זמן והרגעה."
      },
      {
        "start": 12.12,
        "end": 16.2,
        "text": "ויש מי שזקוק לעזרה בהתמצאות או בהבנת השלבים הבאים."
      },
      {
        "start": 16.7,
        "end": 18.48,
        "text": "התפקיד שלנו הוא להקשיב,"
      },
      {
        "start": 18.72,
        "end": 23.52,
        "text": "לגלות רגישות ולנסות להתאים את השירות לצורך האישי של כל מטופל."
      },
      {
        "start": 23.7,
        "end": 26.72,
        "text": "זה לא אומר להבטיח דברים שאי אפשר לקיים."
      },
      {
        "start": 27.46,
        "end": 30.26,
        "text": "זה אומר לעשות את המיטב במסגרת התפקיד"
      },
      {
        "start": 30.26,
        "end": 33.02,
        "text": "והאפשרויות שלנו כדי למצוא מענה מתאים."
      }
    ]
  },
  "AUDIO-S03-04": {
    "status": "machine-transcribed",
    "cues": [
      {
        "start": 0.0,
        "end": 1.62,
        "text": "מלווים אותך לאורך הדרך."
      },
      {
        "start": 2.02,
        "end": 5.44,
        "text": "חוויית המטופל לא מורכבת ממפגש אחד בלבד."
      },
      {
        "start": 6.04,
        "end": 9.54,
        "text": "היא נבנית לאורך רצף של מפגשים, הסברים והחלטות."
      },
      {
        "start": 10.14,
        "end": 13.2,
        "text": "לכן, חשוב שלא נשאיר את המטופל עם סימני שאלה."
      },
      {
        "start": 13.52,
        "end": 15.46,
        "text": "אנחנו מסבירים מה השלב הבא,"
      },
      {
        "start": 15.78,
        "end": 17.22,
        "text": "מוודאים שהמידע ברור,"
      },
      {
        "start": 17.3,
        "end": 22.06,
        "text": "ומסייעים לשמור על רציפות השירות גם כשהאחריות עוברת לאיש צוות אחר."
      },
      {
        "start": 22.34,
        "end": 23.76,
        "text": "ובמקרים המתאימים,"
      },
      {
        "start": 23.78,
        "end": 26.76,
        "text": "אנחנו גם ממשיכים לשמור על קשר לאחר הביקור."
      },
      {
        "start": 26.76,
        "end": 30.8,
        "text": "כך המטופל יודע שיש מי שמלווה אותו לאורך כל הדרך."
      }
    ]
  },
